{
  "name": "tin-cong-nghe-ai",
  "version": "1.0.0",
  "description": "Website tin tức công nghệ tiếng Việt tự động hóa biên tập với AI, triển khai trên Cloudflare Pages & D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public --live-reload --compatibility-date=2024-04-03 --d1=DB",
    "build": "node scripts/build.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "d1:migrate:local": "wrangler d1 migrations apply tin-cong-nghe-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply tin-cong-nghe-db --remote",
    "deploy": "wrangler pages deploy public"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.3",
    "hono": "^4.7.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
