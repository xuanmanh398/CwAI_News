# .env.example
# Sao chép file này thành .env hoặc cấu hình trong Cloudflare Pages Settings > Environment Variables

# Tên và mô tả website
SITE_NAME="Tin Công Nghệ"
SITE_DESCRIPTION="Chuyên trang cập nhật tin tức công nghệ, Trí tuệ nhân tạo (AI), phần mềm, an ninh mạng và thiết bị số nhanh và chính xác."

# URL gốc của website (cập nhật sau khi có domain Pages thực tế: https://<your-project>.pages.dev)
CANONICAL_ORIGIN="http://localhost:8788"

# Mật khẩu quản trị viên (Admin Token bí mật dùng để đăng nhập CMS)
# Tạo chuỗi ngẫu nhiên dài: openssl rand -hex 32
ADMIN_TOKEN="admin-secure-token-change-in-production-1234567890abcdef"

# Chuỗi bí mật dùng để mã hóa session cookie
ADMIN_SESSION_SECRET="session-secret-change-in-production-abcdef1234567890"

# Secret bảo vệ endpoint định kỳ /api/cron/ingest
CRON_SECRET="cron-secret-token-change-in-production"

# Cấu hình AI biên tập
# Mô hình Workers AI (ví dụ: @cf/meta/llama-3.1-8b-instruct)
AI_MODEL="@cf/meta/llama-3.1-8b-instruct"
FALLBACK_TO_METADATA="true"

# Cấu hình Google AdSense (để trống hoặc false khi chưa được duyệt)
ADSENSE_ENABLED="false"
ADSENSE_CLIENT="ca-pub-XXXXXXXXXXXXXXXX"
